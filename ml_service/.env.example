SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Server only. Needed for privacy-preserving duplicate search and public estimates.
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key
SARVAM_API_KEY=your-server-only-key
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_DIR=./models
# Downloads pretrained weights on first request. Set false to disable model inference.
ENABLE_ML=true
